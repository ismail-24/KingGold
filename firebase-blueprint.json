      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "txType": { "type": "string", "enum": ["GOLD_SALE_PROCEEDS", "CASH_DEPOSIT_PENDING", "CASH_DEPOSIT", "FRACTIONAL_GOLD_BUY", "FRACTIONAL_GOLD_PENDING", "MARKETPLACE_ORDER_PAID", "GOLD_RESERVATION", "GOLD_WITHDRAWAL_FULFILLED", "GOLD_RESERVATION_RELEASED", "ADMIN_ADJUSTMENT"] },
        "referenceId": { "type": "string" },
        "karat": { "type": "integer" },
        "cashDeltaPiasters": { "type": "integer" },
        "pendingCashDeltaPiasters": { "type": "integer" },
        "goldDeltaMg": { "type": "integer" },
        "reservedDeltaMg": { "type": "integer" },
        "pendingGoldDeltaMg": { "type": "integer" },
        "unitPricePerGramPiasters": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "idempotencyKey", "txType", "referenceId", "karat", "cashDeltaPiasters", "pendingCashDeltaPiasters", "goldDeltaMg", "reservedDeltaMg", "pendingGoldDeltaMg", "unitPricePerGramPiasters", "notes", "createdAt"]
    },
    "FractionalGoldOrder": {

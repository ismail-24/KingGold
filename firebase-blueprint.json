        "ledgerEntryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerUid", "karat", "weightMg", "pricePerGramPiasters", "totalPiasters", "paymentSource", "status", "ledgerEntryId", "createdAt", "updatedAt"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",

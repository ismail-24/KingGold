{
  "entities": {
    "OrderItemRecord": {
      "title": "OrderItemRecord",
      "description": "Line item inside a verified gold pickup order",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Catalog or merchant product ID" },
        "shopId": { "type": "string", "description": "Merchant or partner shop ID" },
        "name": { "type": "string", "description": "Display title of the gold piece" },
        "category": { "type": "string", "description": "Product category label" },
        "karat": { "type": "integer", "description": "Gold purity karat (18, 21, 24)" },
        "weightGrams": { "type": "number", "description": "Weight per piece in grams" },
        "stamped": { "type": "boolean", "description": "Official hallmark stamp verification" },
        "quantity": { "type": "integer", "description": "Number of pieces ordered" },
        "unitSellingPricePiasters": { "type": "integer", "description": "Final customer selling price per piece in piasters (no extra making charges)" }
      },
      "required": ["productId", "shopId", "name", "category", "karat", "weightGrams", "stamped", "quantity"]
    },
    "GoldOrderRecord": {
      "title": "GoldOrderRecord",
      "description": "Escrow-backed gold order owned by an authenticated buyer",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the buyer" },
        "shopId": { "type": "string", "description": "Merchant or partner shop ID" },
        "shopName": { "type": "string", "description": "Merchant shop display name" },
        "merchantOwnerUid": { "type": "string", "description": "Optional Firebase Auth UID of the owning merchant" },
        "items": { "type": "array", "description": "Bounded list of ordered gold items (max 50)" },
        "goldValue": { "type": "number", "description": "Total product selling value in EGP" },
        "makingFee": { "type": "number", "description": "Additional customer making fee (0 for merchant products under prepaid making-charge policy)" },
        "serviceFee": { "type": "number", "description": "Additional platform fee (0 for transparent merchant selling price)" },
        "totalPiasters": { "type": "integer", "description": "Exact total in piasters" },
        "paymentSource": { "type": "string", "description": "CASH_WALLET or ESCROW_METHOD" },
        "idempotencyKey": { "type": "string", "description": "Unique client idempotency key to prevent duplicate orders" },
        "pickupWindow": { "type": "string", "description": "Scheduled pickup time slot" },
        "status": {
          "type": "string",
          "enum": ["PAID", "PREPARING", "READY_FOR_PICKUP", "COMPLETED", "DISPUTED"],
          "description": "Current escrow order status"
        },
        "ratingGiven": { "type": "integer", "description": "Optional buyer rating from 1 to 5 after completion" },
        "disputeReason": { "type": "string", "description": "Optional buyer dispute explanation" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "shopId", "shopName", "items", "goldValue", "makingFee", "serviceFee", "pickupWindow", "status", "createdAt", "updatedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Buyer KYC status, payment preference, and gold price alert configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the account owner" },
        "kycFrontDone": { "type": "boolean" },
        "kycBackDone": { "type": "boolean" },
        "kycSelfieDone": { "type": "boolean" },
        "kycStatus": { "type": "string", "enum": ["NOT_STARTED", "PENDING_REVIEW", "VERIFIED"] },
        "selectedPaymentMethodId": { "type": "string" },
        "priceAlertEnabled": { "type": "boolean" },
        "priceAlertAbove": { "type": "boolean" },
        "priceAlertKarat": { "type": "integer" },
        "priceAlertTarget": { "type": "string" },
        "fcmToken": { "type": "string" },
        "favoriteShopIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "kycFrontDone", "kycBackDone", "kycSelfieDone", "kycStatus", "selectedPaymentMethodId", "priceAlertEnabled", "priceAlertAbove", "priceAlertKarat", "priceAlertTarget", "favoriteShopIds", "createdAt", "updatedAt"]
    },
    "UserCart": {
      "title": "UserCart",
      "description": "Persistent shopping cart stored under the authenticated buyer",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "shopId": { "type": "string" },
        "shopName": { "type": "string" },
        "merchantOwnerUid": { "type": "string" },
        "items": { "type": "array" },
        "pickupSlotIndex": { "type": "integer" },
        "priceLockExpiresAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "shopId", "shopName", "items", "pickupSlotIndex", "priceLockExpiresAtMs", "createdAt", "updatedAt"]
    },
    "MerchantStore": {
      "title": "MerchantStore",
      "description": "Public merchant storefront and verification status (no PII)",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "Merchant owner Firebase Auth UID" },
        "shopName": { "type": "string" },
        "area": { "type": "string" },
        "address": { "type": "string" },
        "contactPhone": { "type": "string" },
        "verifiedEmail": { "type": "string" },
        "description": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"] },
        "rejectionReason": { "type": "string" },
        "prepaidMakingApproved": { "type": "boolean" },
        "prepaidMakingBudgetPiasters": { "type": "integer" },
        "pricingPolicyNote": { "type": "string" },
        "city": { "type": "string", "description": "Optional Egyptian city name" },
        "latitude": { "type": "number", "description": "Optional store WGS84 latitude" },
        "longitude": { "type": "number", "description": "Optional store WGS84 longitude" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "shopName", "area", "address", "contactPhone", "verifiedEmail", "description", "rating", "reviewsCount", "status", "prepaidMakingApproved", "prepaidMakingBudgetPiasters", "createdAt", "updatedAt"]
    },
    "MerchantPrivateDocs": {
      "title": "MerchantPrivateDocs",
      "description": "Confidential merchant legal identity and tax documentation isolated to owner and admin",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "legalFullName": { "type": "string" },
        "nationalIdNumber": { "type": "string" },
        "commercialRegNumber": { "type": "string" },
        "taxCardNumber": { "type": "string" },
        "authorizationNotes": { "type": "string" },
        "documentThumbnails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "legalFullName", "nationalIdNumber", "commercialRegNumber", "taxCardNumber", "authorizationNotes", "documentThumbnails", "createdAt", "updatedAt"]
    },
    "MerchantAuditLog": {
      "title": "MerchantAuditLog",
      "description": "Verification audit trail for merchant onboarding and status changes",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "merchantOwnerUid": { "type": "string" },
        "actorUid": { "type": "string" },
        "action": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["merchantId", "merchantOwnerUid", "actorUid", "action", "note", "createdAt"]
    },
    "MerchantProduct": {
      "title": "MerchantProduct",
      "description": "Structured gold product listed by an approved merchant at final selling price",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "merchantName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "karat": { "type": "integer" },
        "weightMg": { "type": "integer" },
        "weightGrams": { "type": "number" },
        "sellingPricePiasters": { "type": "integer" },
        "stockQuantity": { "type": "integer" },
        "stamped": { "type": "boolean" },
        "imageThumbnails": { "type": "array" },
        "status": { "type": "string", "enum": ["PENDING_REVIEW", "ACTIVE", "PAUSED", "REJECTED"] },
        "rejectionReason": { "type": "string" },
        "lastOrderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["merchantId", "ownerUid", "merchantName", "name", "description", "category", "karat", "weightMg", "weightGrams", "sellingPricePiasters", "stockQuantity", "stamped", "imageThumbnails", "status", "createdAt", "updatedAt"]
    },
    "MerchantOrderView": {
      "title": "MerchantOrderView",
      "description": "Merchant-scoped projection of marketplace orders without exposing buyer PII",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "merchantId": { "type": "string" },
        "merchantOwnerUid": { "type": "string" },
        "buyerUid": { "type": "string" },
        "items": { "type": "array" },
        "totalPiasters": { "type": "integer" },
        "pickupWindow": { "type": "string" },
        "status": { "type": "string", "enum": ["PAID", "PREPARING", "READY_FOR_PICKUP", "COMPLETED", "DISPUTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "merchantId", "merchantOwnerUid", "buyerUid", "items", "totalPiasters", "pickupWindow", "status", "createdAt", "updatedAt"]
    },
    "SellGoldRequest": {
      "title": "SellGoldRequest",
      "description": "Customer-to-platform physical gold sale request with manual admin inspection and custom making-charge deduction",
      "type": "object",
      "properties": {
        "customerUid": { "type": "string" },
        "customerEmail": { "type": "string" },
        "itemTitle": { "type": "string" },
        "category": { "type": "string" },
        "karat": { "type": "integer" },
        "estimatedWeightMg": { "type": "integer" },
        "conditionNotes": { "type": "string" },
        "photoThumbnails": { "type": "array" },
        "status": { "type": "string", "enum": ["SUBMITTED", "UNDER_REVIEW", "OFFER_SENT", "COMPLETED", "REJECTED", "CANCELLED"] },
        "evaluatorAdminUid": { "type": "string" },
        "verifiedWeightMg": { "type": "integer" },
        "confirmedKarat": { "type": "integer" },
        "referencePricePerGramPiasters": { "type": "integer" },
        "evaluatedGoldValuePiasters": { "type": "integer" },
        "makingChargeDeductionPiasters": { "type": "integer" },
        "finalOfferPiasters": { "type": "integer" },
        "inspectionNotes": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "settlementTransactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerUid", "customerEmail", "itemTitle", "category", "karat", "estimatedWeightMg", "conditionNotes", "photoThumbnails", "status", "verifiedWeightMg", "confirmedKarat", "referencePricePerGramPiasters", "evaluatedGoldValuePiasters", "makingChargeDeductionPiasters", "finalOfferPiasters", "createdAt", "updatedAt"]
    },
    "WalletSummary": {
      "title": "WalletSummary",
      "description": "Authoritative cash wallet (piasters) and digital gold vault (milligrams) balances",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cashAvailablePiasters": { "type": "integer" },
        "cashPendingPiasters": { "type": "integer" },
        "cashTotalCreditedPiasters": { "type": "integer" },
        "cashTotalDebitedPiasters": { "type": "integer" },
        "goldConfirmedMg": { "type": "integer" },
        "goldReservedMg": { "type": "integer" },
        "goldPendingMg": { "type": "integer" },
        "gold24kMg": { "type": "integer" },
        "gold21kMg": { "type": "integer" },
        "gold18kMg": { "type": "integer" },
        "totalInvestedPiasters": { "type": "integer" },
        "lastSettlementRef": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "cashAvailablePiasters", "cashPendingPiasters", "cashTotalCreditedPiasters", "cashTotalDebitedPiasters", "goldConfirmedMg", "goldReservedMg", "goldPendingMg", "gold24kMg", "gold21kMg", "gold18kMg", "totalInvestedPiasters", "lastSettlementRef", "createdAt", "updatedAt"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",

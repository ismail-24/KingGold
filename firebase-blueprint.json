        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["dateKey", "dayLabel", "price24kPerGramPiasters", "price21kPerGramPiasters", "price18kPerGramPiasters", "source", "published", "updatedByAdminUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AuditLogRecord" },
      "description": "Platform administrator roster"
    },
    "/platform_config/{configId}": {
      "schema": { "$ref": "#/entities/PlatformPricingConfig" },
      "description": "Admin-controlled reference & valuation gold pricing configuration"
    },
    "/platform_config/{configId}/history/{entryId}": {
      "schema": { "$ref": "#/entities/PlatformPricingConfig" },
      "description": "Historical daily snapshots of platform gold prices for 30-day Vico trend charts"
    },
    "/merchants/{merchantId}": {
      "schema": { "$ref": "#/entities/MerchantStore" },
      "description": "Merchant store metadata & verification workflow"
    },
    "/merchants/{merchantId}/private/{docId}": {
      "schema": { "$ref": "#/entities/MerchantPrivateDocs" },
      "description": "Private legal documents isolated to owning merchant and admin"
    },
    "/merchants/{merchantId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/MerchantAuditLog" },
      "description": "Merchant verification audit trail"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/MerchantProduct" },
      "description": "Merchant gold products at transparent customer-facing prices"
    },
    "/merchant_orders/{orderId}": {
      "schema": { "$ref": "#/entities/MerchantOrderView" },
      "description": "Merchant-scoped marketplace orders"
    },
    "/sell_requests/{requestId}": {
      "schema": { "$ref": "#/entities/SellGoldRequest" },
      "description": "Customer-to-platform physical gold sale requests"
    },

        "adminUid": { "type": "string" },
        "ledgerEntryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerUid", "customerEmail", "karat", "amountMg", "deliveryType", "deliveryAddress", "withdrawalRef", "status", "ledgerEntryId", "createdAt", "updatedAt"]
    },
